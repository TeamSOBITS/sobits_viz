  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/TeamSOBITS/sobits_viz</url>
  <url type="bugtracker">https://github.com/TeamSOBITS/sobits_viz/issues</url>

  <author email="team.sobits@gmail.com">Team SOBITS</author>
  <author email="kvalentincardenas@gmail.com">VALENTIN Keith</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>sobits_viz_rerun</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
