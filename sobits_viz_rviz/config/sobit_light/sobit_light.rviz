# Generated by sobits_viz_rviz make_config; do not edit by hand.
# Regenerate: ros2 run sobits_viz_rviz make_config --params <robot>.yaml
Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Alpha: 0.5
    Cell Size: 1
    Color: 160; 160; 164
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
    Description Source: Topic
    Description File: ''
    Description Topic:
      Value: /sobit_light/robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    TF Prefix: sobit_light
    Update Interval: 0
  - Class: rviz_default_plugins/LaserScan
    Name: lidar
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 0; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3.0
    Size (m): 0.01
    Style: Points
    Use Fixed Frame: true
    Use rainbow: true
    Topic:
      Value: /sobit_light/lidar/scan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Head
    Enabled: true
    Value: true
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
    Topic:
      Value: /sobit_light/head_camera/color/image_raw/compressed
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Hand
    Enabled: true
    Value: true
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
    Topic:
      Value: /sobit_light/hand_camera/color/image_raw/compressed
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Front
    Enabled: true
    Value: true
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
    Topic:
      Value: /sobit_light/front_camera/image_raw/compressed
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Back
    Enabled: true
    Value: true
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Median window: 5
    Topic:
      Value: /sobit_light/back_camera/image_raw/compressed
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Head depth
    Enabled: true
    Value: true
    Normalize Range: false
    Min Value: 0.0
    Max Value: 10.0
    Median window: 5
    Topic:
      Value: /sobit_light/head_camera/depth/image_rect_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Hand depth
    Enabled: true
    Value: true
    Normalize Range: false
    Min Value: 0.0
    Max Value: 10.0
    Median window: 5
    Topic:
      Value: /sobit_light/hand_camera/depth/image_rect_raw
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Odometry
    Name: Base
    Enabled: true
    Value: true
    Angle Tolerance: 0.1
    Position Tolerance: 0.1
    Keep: 100
    Shape:
      Value: Arrow
    Topic:
      Value: /sobit_light/odometry/odometry
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: sobit_light/odom
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
  - Class: rviz_default_plugins/SetGoal
  - Class: rviz_default_plugins/PublishPoint
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Value: Orbit (rviz_default_plugins)
      Distance: 3.0
      Pitch: 0.5
      Yaw: 0.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Target Frame: sobit_light/odom
    Saved: null
Window Geometry:
  Height: 1000
  Width: 1800
  X: 60
  Y: 30
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
  Head:
    collapsed: false
  Hand:
    collapsed: false
  Front:
    collapsed: false
  Back:
    collapsed: false
  Head depth:
    collapsed: false
  Hand depth:
    collapsed: false
  QMainWindow State: 
